<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Setup — Telegram Categorizer</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    /* ── Design tokens ───────────────────────────────────────────────── */
    :root {
      --bg:             #f1f5f9;
      --surface:        #ffffff;
      --border:         #e2e8f0;
      --text:           #0f172a;
      --text-secondary: #475569;
      --text-muted:     #94a3b8;
      --primary:        #6366f1;
      --primary-dark:   #4f46e5;
      --primary-light:  #eef2ff;
      --danger:         #ef4444;
      --success:        #22c55e;
      --radius:         12px;
      --radius-sm:      8px;
      --shadow:         0 1px 3px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.04);
      --shadow-md:      0 4px 6px -1px rgba(0,0,0,.07), 0 2px 4px -2px rgba(0,0,0,.05);
      --t-fast:         150ms ease;
      --t-base:         240ms ease;
    }

    /* ── Reset ───────────────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    /* ── Header ──────────────────────────────────────────────────────── */
    .header {
      background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
      color: white;
      padding: 24px 40px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      margin-bottom: 32px;
    }
    .header h1 {
      font-size: 1.75rem;
      font-weight: 800;
      letter-spacing: -0.025em;
    }
    .header .subtitle {
      color: rgba(255,255,255,.72);
      font-size: 0.875rem;
      margin-top: 5px;
    }
    .btn-back {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: rgba(255,255,255,.85);
      font-size: 0.85rem;
      font-weight: 500;
      text-decoration: none;
      padding: 8px 16px;
      border: 1px solid rgba(255,255,255,.35);
      border-radius: var(--radius-sm);
      white-space: nowrap;
      transition: background var(--t-fast), color var(--t-fast);
    }
    .btn-back:hover { background: rgba(255,255,255,.15); color: white; }

    /* ── Layout ──────────────────────────────────────────────────────── */
    .container { max-width: 680px; margin: 0 auto; padding: 0 24px 56px; }

    /* ── Cards ───────────────────────────────────────────────────────── */
    .card {
      background: var(--surface);
      border-radius: var(--radius);
      padding: 28px 32px;
      box-shadow: var(--shadow-md);
      margin-bottom: 20px;
    }
    .card h2 {
      font-size: 1.05rem;
      font-weight: 700;
      padding-bottom: 14px;
      margin-bottom: 22px;
      border-bottom: 1px solid var(--border);
    }

    /* ── Form fields ─────────────────────────────────────────────────── */
    .field { margin-bottom: 20px; }
    .field:last-child { margin-bottom: 0; }

    .field label {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 7px;
    }
    .field input,
    .field select {
      width: 100%;
      padding: 10px 14px;
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      font-size: 0.9rem;
      font-family: inherit;
      color: var(--text);
      background: var(--surface);
      outline: none;
      transition: border-color var(--t-fast), box-shadow var(--t-fast);
    }
    .field input:focus,
    .field select:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(99,102,241,.12);
    }
    .field .hint {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 5px;
      line-height: 1.5;
    }
    .field .hint a { color: var(--primary); text-decoration: none; }
    .field .hint a:hover { text-decoration: underline; }

    .saved-badge {
      display: inline-block;
      font-size: 0.68rem;
      color: var(--success);
      font-weight: 700;
      letter-spacing: 0.04em;
    }

    /* ── Grid layout for advanced fields ─────────────────────────────── */
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0 20px; }

    /* ── Section divider (inside advanced) ──────────────────────────── */
    .section-label {
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding-bottom: 8px;
      margin: 22px 0 14px;
      border-bottom: 1px solid var(--border);
    }

    /* ── Advanced accordion ──────────────────────────────────────────── */
    details { overflow: hidden; }
    details summary {
      font-size: 0.875rem;
      font-weight: 600;
      color: var(--primary);
      cursor: pointer;
      user-select: none;
      list-style: none;
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 2px 0;
      transition: color var(--t-fast);
    }
    details summary:hover { color: var(--primary-dark); }
    details summary::before       { content: "▶"; font-size: 0.65rem; }
    details[open] summary::before { content: "▼"; }

    /* ── Alert messages ──────────────────────────────────────────────── */
    .alert {
      padding: 12px 16px;
      border-radius: var(--radius-sm);
      font-size: 0.875rem;
      line-height: 1.5;
      margin-bottom: 20px;
    }
    .alert-error   { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }
    .alert-success { background: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; }
    #statusMsg { display: none; }

    /* ── Save button ─────────────────────────────────────────────────── */
    .btn-primary {
      width: 100%;
      padding: 13px;
      background: var(--primary);
      color: white;
      border: none;
      border-radius: var(--radius-sm);
      font-size: 0.95rem;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      transition: background var(--t-fast), box-shadow var(--t-fast);
      box-shadow: 0 2px 8px rgba(99,102,241,.3);
    }
    .btn-primary:hover    { background: var(--primary-dark); box-shadow: 0 4px 14px rgba(99,102,241,.4); }
    .btn-primary:disabled { opacity: 0.6; cursor: not-allowed; box-shadow: none; }

    /* ── Responsive ──────────────────────────────────────────────────── */
    @media (max-width: 640px) {
      .header  { padding: 20px; }
      .card    { padding: 20px; }
      .grid-2  { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

  <div class="header">
    <div>
      <h1>Telegram Categorizer — Setup</h1>
      <p class="subtitle">Configure credentials and preferences. Everything else happens in the browser.</p>
    </div>
    <a href="/" class="btn-back">← Back to Report</a>
  </div>

  <div class="container">
    <div id="statusMsg" class="alert"></div>

    <form id="setupForm">

      <!-- Telegram -->
      <div class="card">
        <h2>Telegram</h2>

        <div class="field">
          <label>API ID</label>
          <input type="number" name="telegram_api_id"
            value="{{ settings.get('telegram_api_id', '') }}" placeholder="12345678" required>
          <div class="hint">From <a href="https://my.telegram.org/apps" target="_blank">my.telegram.org/apps</a></div>
        </div>

        <div class="field">
          <label>
            API Hash
            {% if settings.get('_api_hash_saved') %}<span class="saved-badge">saved ✓</span>{% endif %}
          </label>
          <input type="password" name="telegram_api_hash"
            placeholder="{% if settings.get('_api_hash_saved') %}••••{{ settings.get('_api_hash_last4', '') }}{% else %}32-character hex string{% endif %}">
          <div class="hint">Leave blank to keep existing value.</div>
        </div>

        <div class="field">
          <label>Phone Number</label>
          <input type="tel" name="telegram_phone"
            value="{{ settings.get('telegram_phone', '') }}" placeholder="+380991234567" required>
        </div>

        <div class="field">
          <label>Channel / Group</label>
          <input type="text" name="channel_username"
            value="{{ settings.get('channel_username', '') }}" placeholder="mygroup or -1001234567890" required>
          <div class="hint">Username without @, or numeric ID for private groups.</div>
        </div>
      </div>

      <!-- OpenAI -->
      <div class="card">
        <h2>OpenAI</h2>

        <div class="field">
          <label>
            API Key
            {% if settings.get('_openai_key_saved') %}<span class="saved-badge">saved ✓</span>{% endif %}
          </label>
          <input type="password" name="openai_api_key"
            placeholder="{% if settings.get('_openai_key_saved') %}sk-...{{ settings.get('_openai_key_last4', '') }}{% else %}sk-...{% endif %}">
          <div class="hint">Leave blank to keep existing value.</div>
        </div>

        <div class="field">
          <label>Categorization Model</label>
          <select name="openai_model">
            {% for m in ['gpt-5', 'gpt-5.1', 'gpt-5.2', 'gpt-5.4', 'gpt-4.1', 'gpt-4.1-mini', 'gpt-4.1-nano', 'gpt-4o', 'gpt-4o-mini', 'o4-mini', 'o3-mini'] %}
            <option value="{{ m }}" {% if settings.get('openai_model', 'gpt-4o') == m %}selected{% endif %}>{{ m }}</option>
            {% endfor %}
          </select>
          <div class="hint">Model used for user categorization batches.</div>
        </div>

        <div class="field">
          <label>Reranker Model</label>
          <select name="reranker_model">
            {% for m in ['gpt-4.1-mini', 'gpt-4.1-nano', 'gpt-4o-mini', 'gpt-5', 'gpt-5.1', 'gpt-5.2', 'gpt-5.4', 'gpt-4.1', 'gpt-4o'] %}
            <option value="{{ m }}" {% if settings.get('reranker_model', 'gpt-4o-mini') == m %}selected{% endif %}>{{ m }}</option>
            {% endfor %}
          </select>
          <div class="hint">Model used for semantic search reranking. Cheaper/faster models work well here.</div>
        </div>
      </div>

      <!-- Advanced -->
      <div class="card">
        <h2>Advanced Settings</h2>
        <details>
          <summary>Show advanced options</summary>

          <p class="section-label">Extraction</p>
          <div class="grid-2">
            <div class="field">
              <label>Max messages to fetch</label>
              <input type="number" name="max_messages" value="{{ settings.get('max_messages', 1000) }}" min="1">
            </div>
            <div class="field">
              <label>Min messages per user</label>
              <input type="number" name="min_messages_per_user" value="{{ settings.get('min_messages_per_user', 1) }}" min="1">
            </div>
            <div class="field">
              <label>Topic ID</label>
              <input type="number" name="topic_id" value="{{ settings.get('topic_id', 8) }}" min="0">
              <div class="hint">ID of the forum thread to scrape. 0 = all topics.</div>
            </div>
          </div>

          <p class="section-label">Categorization</p>
          <div class="grid-2">
            <div class="field">
              <label>Users per LLM call</label>
              <input type="number" name="users_per_batch" value="{{ settings.get('users_per_batch', 5) }}" min="1" max="20">
            </div>
            <div class="field">
              <label>Messages per user in prompt</label>
              <input type="number" name="max_messages_per_user" value="{{ settings.get('max_messages_per_user', 10) }}" min="1">
            </div>
            <div class="field">
              <label>LLM retry attempts</label>
              <input type="number" name="max_retries" value="{{ settings.get('max_retries', 3) }}" min="1">
            </div>
            <div class="field">
              <label>Parallel batch workers</label>
              <input type="number" name="parallel_workers" value="{{ settings.get('parallel_workers', 5) }}" min="1" max="20">
            </div>
          </div>

          <p class="section-label">Search</p>
          <div class="grid-2">
            <div class="field">
              <label>Top-k candidates</label>
              <input type="number" name="search_top_k" value="{{ settings.get('search_top_k', 25) }}" min="1">
            </div>
            <div class="field">
              <label>Search confidence threshold</label>
              <input type="number" name="search_confidence_threshold"
                value="{{ settings.get('search_confidence_threshold', 0.6) }}"
                min="0" max="1" step="0.05">
            </div>
          </div>
        </details>
      </div>

      <button type="submit" class="btn-primary" id="saveBtn">Save Settings</button>
    </form>
  </div>

  <script>
    const form      = document.getElementById('setupForm');
    const statusMsg = document.getElementById('statusMsg');
    const saveBtn   = document.getElementById('saveBtn');

    function showMsg(text, type) {
      statusMsg.className    = `alert alert-${type}`;
      statusMsg.textContent  = text;
      statusMsg.style.display = 'block';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    form.addEventListener('submit', async e => {
      e.preventDefault();
      saveBtn.disabled    = true;
      saveBtn.textContent = 'Saving...';

      const data = Object.fromEntries(new FormData(form));
      if (!data.telegram_api_hash) delete data.telegram_api_hash;
      if (!data.openai_api_key)    delete data.openai_api_key;

      const intFields = [
        'telegram_api_id', 'max_messages', 'min_messages_per_user', 'topic_id',
        'users_per_batch', 'max_messages_per_user', 'max_retries', 'parallel_workers', 'search_top_k',
      ];
      intFields.forEach(k => { if (data[k] !== undefined) data[k] = parseInt(data[k], 10); });
      if (data.search_confidence_threshold)
        data.search_confidence_threshold = parseFloat(data.search_confidence_threshold);

      try {
        const resp = await fetch('/api/setup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await resp.json();
        if (resp.ok) {
          showMsg('Settings saved! Redirecting...', 'success');
          setTimeout(() => { window.location.href = '/'; }, 900);
        } else {
          showMsg('Error: ' + (json.detail || JSON.stringify(json)), 'error');
        }
      } catch (err) {
        showMsg('Network error: ' + err.message, 'error');
      } finally {
        saveBtn.disabled    = false;
        saveBtn.textContent = 'Save Settings';
      }
    });
  </script>
</body>
</html>
