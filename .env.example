# Telegram API credentials (get from https://my.telegram.org/apps)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_PHONE=+1234567890

# The channel/group to analyze (username without @, or numeric ID like -1001234567890)
CHANNEL_USERNAME=-1003736703264
TOPIC_ID=8

# Extraction
MAX_MESSAGES=1000
MIN_MESSAGES_PER_USER=1

# OpenAI (get key from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o
USERS_PER_BATCH=5
MAX_MESSAGES_PER_USER=10
MAX_RETRIES=3

# Prompts & Categories
PROMPT_FILE=./prompts/system_prompt.txt
FEW_SHOT_FILE=./prompts/few_shot_example.txt
CATEGORIES_FILE=./config/categories.json

# Filtering (applied after categorization, does not re-run LLM)
# FILTER_INCLUDE_CATEGORIES=Agentic AI,Pro
# FILTER_EXCLUDE_CATEGORIES=Non-concrete,Uncategorized
# FILTER_SKIP_USER_IDS=12345,67890
# FILTER_REQUIRE_TAGS=ai agents,trading
# FILTER_ONLY_WORTH_CHECKING=false

# Output
OUTPUT_DIR=./output
